+class _InMemoryCursor:
+    def __init__(self, docs: list[dict]):
+        self._docs = docs
+
+    def sort(self, key: str, direction: int = 1):
+        reverse = direction < 0
+        self._docs.sort(key=lambda d: d.get(key, ''), reverse=reverse)
+        return self
+
+    async def to_list(self, length: int):

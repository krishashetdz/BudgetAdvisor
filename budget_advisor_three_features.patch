+  const [minBudget, setMinBudget] = useState<string>(() => String(Math.max(500, Math.round(baseBudget * 0.2))));
+  const [maxBudget, setMaxBudget] = useState<string>(() => String(Math.max(2000, Math.round(baseBudget * 1.6))));

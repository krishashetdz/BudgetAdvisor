+.insight-icon{width:30px;height:30px;border-radius:5px;background:var(--accent-soft);color:var(--accent-dark);display:grid;place-items:center;flex-shrink:0}
+.insight-card h3{font-size:14px;font-weight:600;margin-bottom:5px}
+.insight-card p{font-size:12px;color:var(--muted);line-height:1.65}
+.reports-cards-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:20px}
+.report-action-card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:26px;display:flex;flex-direction:column;gap:18px}
+.report-card-top{display:flex;align-items:center;gap:14px}
+.report-icon{width:42px;height:42px;border-radius:6px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;flex-shrink:0}
+.report-description{font-size:12px;color:var(--muted);line-height:1.75}
+.report-form-fields{display:flex;flex-direction:column;gap:14px;padding:16px;background:#f8faf9;border:1px solid var(--line);border-radius:5px}
+.report-options-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
+.report-sections-preview{border-top:1px solid var(--line);padding-top:16px;flex:1}
+.report-sections-preview>span{display:block;font-size:11px;font-weight:600;color:var(--ink);margin-bottom:10px}
+.report-sections-preview ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}
+.report-sections-preview li{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}
+.report-sections-preview li svg{color:var(--accent)}
+.report-download-btn{width:100%;justify-content:center;height:40px!important}
+@media(max-width:960px){.benchmark-charts-grid,.sensitivity-main-grid,.insights-grid,.reports-cards-grid{grid-template-columns:1fr}.control-actions{width:100%;justify-content:flex-start}}
